<?xml version="1.0" encoding="utf-8"?>
<!-- AKAI sign icon, Round, foreground layer: dark-red disc with the AKAI
     lettering, centred. On the red background layer and under a circular launcher mask (Pixel)
     this gives a red ring around a dark-red circle. The disc (radius 32) stays inside the
     visible circle (radius 36 of the 108 canvas), so the ring is about 4 units wide.
     The squircle variant is ic_launcher_akai_squircle_*.xml; see mipmap-anydpi-v26. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M22,54 A32,32 0 1,0 86,54 A32,32 0 1,0 22,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="54"
                android:endY="86"
                android:startX="54"
                android:startY="22"
                android:type="linear">
                <item
                    android:color="#FF6E191F"
                    android:offset="0" />
                <item
                    android:color="#FF480E12"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Lettering: glyphs drawn in a 278x180 box, scaled to 44 units wide and centred. -->
    <group
        android:scaleX="0.1583"
        android:scaleY="0.1583"
        android:translateX="32"
        android:translateY="39.75">
        <path
            android:fillColor="#F6F1EC"
            android:fillType="evenOdd"
            android:pathData="M29,0H43L72,180H52L45.5,140H26.5L20,180H0Z M36,80.7L42.3,120H29.7Z" />
        <path
            android:fillColor="#F6F1EC"
            android:pathData="M90,0H110V78L128,0H150L126,92L150,180H128L110,112V180H90Z" />
        <path
            android:fillColor="#F6F1EC"
            android:fillType="evenOdd"
            android:pathData="M197,0H211L240,180H220L213.5,140H194.5L188,180H168Z M204,80.7L210.3,120H197.7Z" />
        <path
            android:fillColor="#F6F1EC"
            android:pathData="M258,0H278V180H258Z" />
    </group>
</vector>
