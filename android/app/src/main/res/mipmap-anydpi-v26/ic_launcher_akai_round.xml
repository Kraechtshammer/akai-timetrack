<?xml version="1.0" encoding="utf-8"?>
<!-- AKAI sign icon, Round: red background, dark-red disc with the lettering, for round launcher
     masks (Pixel). One of the icon variants the app switches with activity aliases
     (AndroidManifest.xml, MainActivity.kt); the cloche and penguin variants are generated by
     branding/icons/generate.js. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_red" />
    <foreground android:drawable="@drawable/ic_launcher_akai_round_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_akai_monochrome" />
</adaptive-icon>
