<?xml version="1.0" encoding="utf-8"?>
<!-- App icon "Rund": red background, dark-red disc with the lettering. Made for circular launcher
     masks (Pixel). minSdk is 29, so adaptive icons cover every supported device.
     The launcher picks the mask shape and apps can't find it out, so there is a second variant,
     ic_launcher_squircle (Xiaomi). The app switches between them with activity aliases
     (AndroidManifest.xml, MainActivity.kt). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_red" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
