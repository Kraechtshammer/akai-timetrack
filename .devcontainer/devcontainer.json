{
  "name": "TimeTrack (Flutter + Android)",
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    // Only for the Claude Code CLI (npm) and the token setup script
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },

  // adb in the container uses the adb server on Windows when it's running (USB devices,
  // wireless-debugging devices, emulators), otherwise its own server; see .devcontainer/adb-wrapper.sh
  // and docs/03-dev-setup.md. Host networking lets the container find Windows when Docker runs
  // inside WSL 2 (Windows is the WSL VM's default gateway). It works with Docker Desktop too.
  //
  // Emulator (scripts/emulator.sh): KVM for speed and WSLg's display for the window. These need
  // Docker in WSL 2; with Docker Desktop, remove the last five entries (see docs/03-dev-setup.md).
  "runArgs": [
    "--network=host",
    "--device=/dev/kvm",
    "-v", "/mnt/wslg:/mnt/wslg",
    "-v", "/mnt/wslg/.X11-unix:/tmp/.X11-unix"
  ],
  // Reaps exited background processes (e.g. a stopped emulator) so they don't linger as zombies
  "init": true,
  // Emulator and Android image (~6-8 GB once set up), kept across container rebuilds
  "mounts": [
    "source=timetrack-emulator,target=/home/vscode/.android-emu,type=volume"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "anthropic.claude-code"
      ],
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter",
        "dart.checkForSdkUpdates": false,
        "dart.debugExternalPackageLibraries": false,
        "dart.debugSdkLibraries": false,
        "[dart]": {
          "editor.formatOnSave": true,
          "editor.rulers": [80]
        }
      }
    }
  },

  // Runs first, so the token hook is in ~/.bashrc before the first terminal opens.
  "onCreateCommand": "bash .devcontainer/load-env.sh",
  // Claude Code CLI and Flutter packages. See the script.
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
