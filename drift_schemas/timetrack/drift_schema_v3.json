        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tip_payouts\" (\"id\" TEXT NOT NULL, \"week_start\" TEXT NOT NULL UNIQUE, \"amount_cents\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
