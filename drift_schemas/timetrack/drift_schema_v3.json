    {
      "name": "shifts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shifts\" (\"id\" TEXT NOT NULL, \"notif_id\" INTEGER NOT NULL UNIQUE, \"day\" TEXT NOT NULL, \"type\" INTEGER NOT NULL, \"planned_start\" INTEGER NOT NULL, \"planned_end\" INTEGER NOT NULL, \"planned_customized\" INTEGER NOT NULL DEFAULT 0 CHECK (\"planned_customized\" IN (0, 1)), \"raw_start\" INTEGER NULL, \"raw_end\" INTEGER NULL, \"actual_start\" INTEGER NULL, \"actual_end\" INTEGER NULL, \"break_minutes\" INTEGER NOT NULL DEFAULT 0, \"calendar_event_id\" TEXT NULL, \"calendar_id\" TEXT NULL, \"sync_state\" INTEGER NOT NULL DEFAULT 1, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "tip_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tip_days\" (\"id\" TEXT NOT NULL, \"day\" TEXT NOT NULL UNIQUE, \"pool_cents\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tip_payouts",
